# Адрес сайта. Используется для canonical, Open Graph и sitemap.
# Без него подставляется https://set-your-domain.invalid — это
# намеренно нерабочий домен, чтобы placeholder нельзя было
# случайно выкатить в продакшен.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Админка фото (/admin) ---
# Все три ниже — опциональны для обычной работы сайта: без них
# npm run build и сам сайт работают как обычно, просто /admin
# будет недоступна/неполнофункциональна. Подробная инструкция
# по получению каждого значения — в README → «Админка фото».

# Пароль для входа в /admin. Без него /admin закрыта для всех,
# а не открыта — отсутствие пароля не равно свободному доступу.
ADMIN_PASSWORD=

# Vercel Blob — хранилище загруженных фото.
# Vercel → проект → Storage → Create Database → Blob.
# Значение подставляется автоматически при подключении Blob
# к проекту (Settings → Environment Variables) — вручную обычно
# копировать не нужно.
BLOB_READ_WRITE_TOKEN=

# Redis (Upstash) — список фото на каждый проект.
# Vercel → проект → Storage → Create Database → в Marketplace
# найти "Redis" (Upstash). Оба значения подставляются автоматически
# после подключения — вручную обычно копировать не нужно.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Deploy Hook — запускает пересборку сайта после загрузки/удаления
# фото (сайт статический, без пересборки новое фото не появится).
# Vercel → проект → Settings → Git → Deploy Hooks → Create Hook.
VERCEL_DEPLOY_HOOK_URL=
